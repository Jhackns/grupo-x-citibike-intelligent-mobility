# Copiar a un archivo privado y pasarlo mediante --env-file; nunca versionarlo.
# También se detecta pyspark/.env.u2. El entorno del proceso tiene prioridad.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=citibike-raw

# Solo para --credencial secreta, si la clave publicable no permite leer.
# El archivo local existente ya contiene esta variable. No se cambia ningún permiso.
SUPABASE_SECRET_KEY=
