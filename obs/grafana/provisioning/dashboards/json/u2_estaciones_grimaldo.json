{
  "uid": "u2-estaciones-grimaldo",
  "title": "U2 · Estaciones — Grimaldo (CitiBike Intelligent Mobility)",
  "description": "Dimensión U2 Estaciones: demanda en vivo por estación, pronóstico t+1, telemetría GBFS y observabilidad del pipeline.",
  "tags": [
    "lambda26",
    "citibike",
    "u2",
    "estaciones"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
